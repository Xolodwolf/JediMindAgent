APP_NAME=JediMindAgent
# local включает DEBUG; для сервера поставьте production и задайте DJANGO_SECRET_KEY.
APP_ENV=local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Администратор создаётся при первом старте, если такого пользователя ещё нет.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=

# База данных. По умолчанию PostgreSQL с pgvector поднимается в контейнере db.
# Внешняя база (Neon, Supabase и т.п.): удалите строку COMPOSE_PROFILES и задайте DATABASE_URL,
# например postgresql://user:password@host/db?sslmode=require. Нужно расширение vector (pgvector).
COMPOSE_PROFILES=local-db
# DATABASE_URL=

# Веб-сервер: процессы и потоки gunicorn. Запросы к LLM ждут сеть, одного процесса обычно хватает.
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=8
# false — миграции не применяются при старте web (если у хостинга есть отдельный шаг релиза).
# RUN_MIGRATIONS=true

# RAG-сервис.
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_THREADS=
# Удалять PDF после индексации (для хостинга без постоянного диска).
# RAG_DELETE_PDF_AFTER_INDEXING=false

# Модель LLM, шлюз к ней и настройки RAG задаются в админке: http://localhost:8000/admin/
