# RAG service: FastAPI + fastembed (ONNX Runtime, no PyTorch) + the book worker. All ML dependencies live here.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    MEDIA_ROOT=/app/media \
    EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 \
    EMBEDDING_CACHE_DIR=/opt/fastembed

WORKDIR /app

RUN useradd --uid 1000 --create-home app && mkdir -p /app/media && chown app /app/media

COPY requirements-rag.txt ./
RUN pip install --no-cache-dir -r requirements-rag.txt

# The model is baked into the image: a host without a persistent disk would otherwise download it on every cold start.
RUN python -c "import os; from fastembed import TextEmbedding; TextEmbedding(os.environ['EMBEDDING_MODEL'], cache_dir=os.environ['EMBEDDING_CACHE_DIR'])" \
    && chown -R app /opt/fastembed
ENV HF_HUB_OFFLINE=1

COPY src/rag_service ./src/rag_service
COPY tests/__init__.py ./tests/__init__.py
COPY tests/rag_service ./tests/rag_service

USER app
EXPOSE 8001

CMD ["uvicorn", "rag_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
